# Copy to .env. Everything is optional: with no values the app runs with the
# built-in demo source and the heuristic (non-AI) provider.

# --- LLM: mock | bedrock | azure_openai (also changeable in Admin > LLM) ---
LLM_PROVIDER=mock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# On EC2 use an instance role instead of keys. Local only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# --- Security (generated into LOGFIX_DATA_DIR if unset; set these in production) ---
# LOGFIX_ADMIN_PASSWORD=          # if unset, a random one is written to data/initial_admin_password.txt
# LOGFIX_JWT_SECRET=
# LOGFIX_SECRET_KEY=              # random passphrase, 32+ chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
# LOGFIX_CORS_ORIGINS=
# LOGFIX_PUBLIC_URL=https://your-app.onrender.com   # used in alert links and the GitHub webhook URL
# LOGFIX_GIT_HOSTS=github.mycompany.com             # extra allowed Git hosts (GitHub Enterprise)
# LOGFIX_REPO_ROOTS=/srv/repos    # restrict where the code assistant may read

# --- Operations ---
# LOGFIX_DATA_DIR=data
# LOGFIX_RETENTION_DAYS=7
